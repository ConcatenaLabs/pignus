#!/usr/bin/env python3
# Copyright (c) 2026 The Sequentia developers
# Distributed under the MIT software license.
"""Pignus command line: propose loans, and check the ones you are offered.

The command that matters is `verify`. Everything Pignus claims about being
non-custodial reduces to one check -- rebuild the vault address from the terms
you agreed and confirm it is the address being funded -- and this is where a
person can run it themselves, without trusting a wallet, a book or a
counterparty's description of the deal.

    pignus-cli selftest
    pignus-cli quote     --market GOLD/USDX --collateral-ref 3000 --debt-ref 1
    pignus-cli propose   --collateral-asset <id> --debt-asset <id> ... > loan.json
    pignus-cli show      --terms loan.json --price 30000000
    pignus-cli address   --terms loan.json
    pignus-cli verify    --terms loan.json --txid <funding> --vout 0
    pignus-cli status    --terms loan.json --txid <funding> --vout 0
    pignus-cli check-attestation --oracle-x <hex> --attestation att.json
"""

import argparse
import json
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), ".."))

from pignus import compat, oracle as O          # noqa: E402
from pignus.node import Node                    # noqa: E402
from pignus.terms import LoanTerms, feed_id     # noqa: E402
from pignus.watcher import VaultWatcher         # noqa: E402


def read_terms(path):
    with open(path) as f:
        return LoanTerms.from_json(f.read())


def node_from(args):
    return Node(url=args.rpc, user=args.rpc_user, password=args.rpc_password,
                wallet=args.rpc_wallet, cookie_path=args.rpc_cookie)


def add_node_args(p):
    p.add_argument("--rpc", default="http://127.0.0.1:18443")
    p.add_argument("--rpc-user")
    p.add_argument("--rpc-password")
    p.add_argument("--rpc-wallet")
    p.add_argument("--rpc-cookie")


# --------------------------------------------------------------- commands

def cmd_selftest(args):
    n = compat.verify_builder()
    print(f"covenant builder matches all {n} golden vault vectors")
    sec = O.generate_key()
    x = O.xonly_pubkey(sec)
    att = O.sign(sec, "GOLD/USDX", 300 * 100_000, 100_000)
    assert O.verify(x, att), "self-signed attestation failed to verify"
    print("oracle sign/verify round-trip ok (48-byte BIP340 message)")
    return 0


def cmd_quote(args):
    price = O.quote_price(args.collateral_ref, args.debt_ref,
                          args.collateral_precision, args.debt_precision,
                          args.price_scale)
    back = O.unquote_price(price, args.collateral_precision,
                           args.debt_precision, args.price_scale)
    c, d = [p.strip().upper() for p in args.market.split("/")]
    print(json.dumps({
        "market": args.market.upper(),
        "feed_id": feed_id(args.market).hex(),
        "price": price,
        "price_scale": args.price_scale,
        "reads_as": f"1 {c} = {back:,.8f} {d}",
        "strike_at_ltv": {
            f"{int(ltv*100)}%": round(price * ltv)
            for ltv in (0.5, 0.6, 0.7, 0.8)},
    }, indent=2))
    return 0


def cmd_propose(args):
    t = LoanTerms(
        collateral_asset=args.collateral_asset, debt_asset=args.debt_asset,
        collateral_amount=args.collateral_amount, principal=args.principal,
        debt=args.debt, borrower_x=args.borrower_x, lender_x=args.lender_x,
        market=args.market, oracle_x=args.oracle_x, strike=args.strike,
        not_before=args.not_before, maturity=args.maturity,
        recover_after=args.recover_after, bonus_num=args.bonus_num,
        bonus_den=args.bonus_den, price_scale=args.price_scale,
        max_price=args.max_price, memo=args.memo or "")
    warnings = t.sanity_check()
    for w in warnings:
        print(f"warning: {w}", file=sys.stderr)
    print(t.to_json())
    return 0


def cmd_show(args):
    t = read_terms(args.terms)
    print(t.describe(args.price))
    print(f"  vault address (scriptPubKey) {t.script_pubkey().hex()}")
    return 0


def cmd_address(args):
    print(read_terms(args.terms).script_pubkey().hex())
    return 0


def cmd_verify(args):
    """The check. Prints what it compared, so a person can see it was done."""
    t = read_terms(args.terms)
    if args.spk:
        funded = args.spk
    else:
        node = node_from(args)
        tx = node.getrawtransaction(args.txid, True)
        funded = tx["vout"][args.vout]["scriptPubKey"]["hex"]
    try:
        t.verify_funding(funded)
    except ValueError as e:
        print(f"REFUSED\n{e}", file=sys.stderr)
        return 2
    print("OK: the funded output is exactly what these terms compile to")
    print(f"  terms      {t.loan_id()}")
    print(f"  scriptPubKey {funded}")
    print("  internal key is NUMS: there is no key path, so the four leaves are")
    print("  the only ways this collateral can move.")
    for w in t.sanity_check():
        print(f"  ! {w}")
    return 0


def cmd_status(args):
    t = read_terms(args.terms)
    node = node_from(args)
    w = VaultWatcher(node, min_depth=args.min_depth)
    v = w.track(t.loan_id(), t, args.txid, args.vout)
    w.poll()
    out = v.to_dict()
    if args.price is not None:
        out["price"] = args.price
        out["health"] = round(t.health(args.price), 4)
        out["ltv"] = round(t.ltv(args.price), 4)
        out["liquidatable"] = t.is_liquidatable(args.price)
        out["seizure_if_liquidated"] = t.seizure_at(args.price)
        out["surplus_if_liquidated"] = t.surplus_at(args.price)
    out["height"] = node.getblockcount()
    out["past_maturity"] = out["height"] >= t.maturity
    print(json.dumps(out, indent=2))
    return 0


def cmd_check_attestation(args):
    with open(args.attestation) as f:
        att = O.Attestation.from_dict(json.load(f))
    ok = O.verify(args.oracle_x, att)
    print(json.dumps({
        "valid": ok,
        "market": att.market,
        "feed_id": att.feed_id,
        "feed_matches_market": feed_id(att.market).hex() == att.feed_id,
        "price": att.price,
        "timestamp": att.timestamp,
        "message": att.message().hex(),
    }, indent=2))
    return 0 if ok else 2


# --- Tier C: pledged collateral on an OpenAMP asset --------------------------

def cmd_pledge_sign(args):
    """Produce the authorisation the issuer's server demands.

    Printed rather than sent, deliberately: the party whose key this is may not
    be the party running the command, and a signature is the thing that travels
    between them. `pignus-cli pledge-release` sends one.
    """
    from pignus import openamp as OA
    sec = bytes.fromhex(open(args.key).read().strip()) if args.key_file \
        else bytes.fromhex(args.key)
    sig = OA.sign_pledge(sec, args.action, args.pledge, args.extra)
    print(json.dumps({
        "pledge": args.pledge, "action": args.action, "extra": args.extra,
        "signed_by": OA.party_key(sec),
        "message": OA.pledge_message(args.action, args.pledge, args.extra).hex(),
        "signature": sig,
    }, indent=2))


def _pledge_client(args):
    from pignus import openamp as OA
    tok = args.token
    if not tok:
        raise SystemExit(
            "an issuer token is required (--token, or PIGNUS_ISSUER_TOKEN in the "
            "environment). It authenticates the caller; it does NOT authorise a "
            "release or a seizure, which need the parties' own signatures.")
    return OA.PledgeClient(args.issuer, tok)


def cmd_pledge_list(args):
    from pignus import openamp as OA
    out = _pledge_client(args).list(asset=args.asset, holder=args.holder,
                                    lender=args.lender, state=args.state)
    for p in out:
        print(OA.describe(p))
    if not out:
        print("no pledges match")


def cmd_pledge_create(args):
    p = _pledge_client(args).create(
        args.asset, args.borrower, args.lender, args.atoms, args.maturity,
        debt_asset=args.debt_asset, debt_atoms=args.debt_atoms, note=args.note)
    print(json.dumps(p, indent=2))


def cmd_pledge_release(args):
    sec = bytes.fromhex(open(args.key).read().strip()) if args.key_file \
        else (bytes.fromhex(args.key) if args.key else None)
    out = _pledge_client(args).release(
        args.pledge, lender_sec=sec, repaid_txid=args.repaid_txid,
        force=args.force, reason=args.reason)
    print(json.dumps(out, indent=2))


def cmd_pledge_seize(args):
    lender = bytes.fromhex(open(args.key).read().strip()) if args.key_file \
        else bytes.fromhex(args.key)
    borrower = None
    if args.borrower_key:
        borrower = bytes.fromhex(args.borrower_key)
    out = _pledge_client(args).seize(args.pledge, args.reason, lender, borrower)
    print(json.dumps(out, indent=2))


# --- Tier D: a repurchase against an OpenDAMP asset --------------------------

def cmd_repo_propose(args):
    from pignus.repurchase import RepurchaseTerms
    t = RepurchaseTerms(
        collateral_asset=args.collateral_asset,
        collateral_amount=args.collateral_amount,
        debt_asset=args.debt_asset, principal=args.principal, debt=args.debt,
        collateral_value=args.collateral_value,
        borrower_cu=args.borrower_cu, borrower_prog=args.borrower_prog,
        lender_prog=args.lender_prog, borrower_ver=args.borrower_ver,
        lender_ver=args.lender_ver, forfeit_after=args.forfeit_after,
    ).sanity_check()
    doc = json.loads(t.to_json())
    doc["bond"] = t.bond()
    doc["address_program"] = t.script_pubkey().hex()
    doc["product"] = "repurchase"
    doc["confirmation"] = t.describe()
    out = json.dumps(doc, indent=2)
    if args.out:
        open(args.out, "w").write(out + "\n")
        print(f"wrote {args.out}")
    else:
        print(out)


def cmd_repo_show(args):
    from pignus.repurchase import RepurchaseTerms, settlement_shape
    t = RepurchaseTerms.from_json(open(args.terms).read())
    print(t.describe())
    print()
    print(f"bond            {t.bond()} atoms of {t.debt_asset}")
    print(f"vault program   {t.script_pubkey().hex()}")
    print(f"forfeit after   height {t.forfeit_after}")
    print()
    shape = settlement_shape(True)
    print("settlement (exactly OpenDAMP's limits, no spare slot in either "
          "direction):")
    for i in shape["inputs"]:
        print("  in   " + i)
    for o in shape["outputs"]:
        print("  out  " + o)


def cmd_repo_verify(args):
    from pignus.repurchase import RepurchaseTerms
    t = RepurchaseTerms.from_json(open(args.terms).read())
    node = node_from(args)
    o = t.verify_funding(node, args.txid,
                         None if args.vout is None else args.vout)
    print(json.dumps({"ok": True, "bond": t.bond(),
                      "vout": o["n"], "asset": o.get("asset")}, indent=2))
    print()
    print(t.describe())


def main():
    ap = argparse.ArgumentParser(
        prog="pignus-cli", description=__doc__.split("\n")[0],
        formatter_class=argparse.RawDescriptionHelpFormatter, epilog=__doc__)
    sub = ap.add_subparsers(dest="cmd", required=True)

    sub.add_parser("selftest").set_defaults(fn=cmd_selftest)

    # --- Tier C ---------------------------------------------------------------
    def issuer_args(q):
        q.add_argument("--issuer", default=os.environ.get(
            "PIGNUS_ISSUER", "http://127.0.0.1:8722"),
            help="the issuer's openampd base url")
        q.add_argument("--token", default=os.environ.get("PIGNUS_ISSUER_TOKEN", ""),
                       help="issuer token; authenticates the caller only")

    p = sub.add_parser("pledge-sign",
                       help="sign a Tier C release or seizure with your own key")
    p.add_argument("--action", choices=("release", "seize"), required=True)
    p.add_argument("--pledge", required=True)
    p.add_argument("--extra", default="",
                   help="the repayment txid for a release, the reason for a seizure")
    p.add_argument("--key", required=True, help="your private key, hex")
    p.add_argument("--key-file", action="store_true",
                   help="--key names a file holding the key instead")
    p.set_defaults(fn=cmd_pledge_sign)

    p = sub.add_parser("pledge-list", help="Tier C pledges at an issuer")
    issuer_args(p)
    for name in ("asset", "holder", "lender", "state"):
        p.add_argument("--" + name, default=None)
    p.set_defaults(fn=cmd_pledge_list)

    p = sub.add_parser("pledge-create", help="lock Tier C collateral in place")
    issuer_args(p)
    p.add_argument("--asset", required=True)
    p.add_argument("--borrower", required=True, help="the borrower's AID")
    p.add_argument("--lender", required=True, help="the lender's AID")
    p.add_argument("--atoms", type=int, required=True)
    p.add_argument("--maturity", type=int, required=True, help="height")
    p.add_argument("--debt-asset", default="")
    p.add_argument("--debt-atoms", type=int, default=0)
    p.add_argument("--note", default="")
    p.set_defaults(fn=cmd_pledge_create)

    p = sub.add_parser("pledge-release",
                       help="Tier C: the debt is settled, unlock the collateral")
    issuer_args(p)
    p.add_argument("--pledge", required=True)
    p.add_argument("--key", default=None, help="the LENDER's private key, hex")
    p.add_argument("--key-file", action="store_true")
    p.add_argument("--repaid-txid", default="")
    p.add_argument("--force", action="store_true",
                   help="issuer override for a lender who cannot sign; needs --reason")
    p.add_argument("--reason", default="")
    p.set_defaults(fn=cmd_pledge_release)

    p = sub.add_parser("pledge-seize",
                       help="Tier C: deliver defaulted collateral to the lender")
    issuer_args(p)
    p.add_argument("--pledge", required=True)
    p.add_argument("--reason", required=True)
    p.add_argument("--key", required=True, help="the LENDER's private key, hex")
    p.add_argument("--key-file", action="store_true")
    p.add_argument("--borrower-key", default=None,
                   help="the borrower's key; required before maturity")
    p.set_defaults(fn=cmd_pledge_seize)

    # --- Tier D ---------------------------------------------------------------
    p = sub.add_parser("repo-propose",
                       help="write a REPURCHASE document (Tier D; not a loan)")
    for name in ("collateral-asset", "debt-asset", "borrower-cu",
                 "borrower-prog", "lender-prog"):
        p.add_argument("--" + name, required=True)
    for name in ("collateral-amount", "principal", "debt", "collateral-value",
                 "forfeit-after"):
        p.add_argument("--" + name, type=int, required=True)
    p.add_argument("--borrower-ver", type=int, default=1)
    p.add_argument("--lender-ver", type=int, default=1)
    p.add_argument("--out", default=None)
    p.set_defaults(fn=cmd_repo_propose)

    p = sub.add_parser("repo-show", help="describe a repurchase and its settlement")
    p.add_argument("terms")
    p.set_defaults(fn=cmd_repo_show)

    p = sub.add_parser("repo-verify",
                       help="THE check: does this bond vault match these terms")
    p.add_argument("terms")
    p.add_argument("--txid", required=True)
    p.add_argument("--vout", type=int, default=None)
    add_node_args(p)
    p.set_defaults(fn=cmd_repo_verify)


    p = sub.add_parser("quote", help="reference prices -> the covenant's integer price")
    p.add_argument("--market", required=True)
    p.add_argument("--collateral-ref", type=float, required=True)
    p.add_argument("--debt-ref", type=float, required=True)
    p.add_argument("--collateral-precision", type=int, default=8)
    p.add_argument("--debt-precision", type=int, default=8)
    p.add_argument("--price-scale", type=int, default=100_000)
    p.set_defaults(fn=cmd_quote)

    p = sub.add_parser("propose", help="write a loan terms document")
    for name in ("collateral-asset", "debt-asset", "borrower-x", "lender-x",
                 "oracle-x", "market"):
        p.add_argument("--" + name, required=True)
    for name, default in (("collateral-amount", None), ("principal", None),
                          ("debt", None), ("strike", None), ("maturity", None),
                          ("recover-after", None), ("not-before", 0),
                          ("bonus-num", 105), ("bonus-den", 100),
                          ("price-scale", 100_000), ("max-price", 0)):
        p.add_argument("--" + name, type=int, default=default,
                       required=default is None)
    p.add_argument("--memo", default="")
    p.set_defaults(fn=cmd_propose)

    p = sub.add_parser("show", help="describe a loan, optionally at a price")
    p.add_argument("--terms", required=True)
    p.add_argument("--price", type=int)
    p.set_defaults(fn=cmd_show)

    p = sub.add_parser("address", help="the vault scriptPubKey these terms compile to")
    p.add_argument("--terms", required=True)
    p.set_defaults(fn=cmd_address)

    p = sub.add_parser("verify", help="THE check: do these terms match the funded vault")
    p.add_argument("--terms", required=True)
    p.add_argument("--spk", help="the funded scriptPubKey, if you have it directly")
    p.add_argument("--txid")
    p.add_argument("--vout", type=int, default=0)
    add_node_args(p)
    p.set_defaults(fn=cmd_verify)

    p = sub.add_parser("status", help="reconcile a loan against the chain")
    p.add_argument("--terms", required=True)
    p.add_argument("--txid", required=True)
    p.add_argument("--vout", type=int, default=0)
    p.add_argument("--price", type=int)
    p.add_argument("--min-depth", type=int, default=2)
    add_node_args(p)
    p.set_defaults(fn=cmd_status)

    p = sub.add_parser("check-attestation", help="verify a signed price")
    p.add_argument("--oracle-x", required=True)
    p.add_argument("--attestation", required=True)
    p.set_defaults(fn=cmd_check_attestation)

    args = ap.parse_args()
    if args.cmd == "verify" and not args.spk and not args.txid:
        ap.error("verify needs --spk or --txid")
    try:
        return args.fn(args)
    except compat.CovenantUnavailable as e:
        print(f"error: {e}", file=sys.stderr)
        return 3


if __name__ == "__main__":
    sys.exit(main())
