[Unit]
Description=Pignus service check, every five minutes
Documentation=https://github.com/ConcatenaLabs/pignus

[Timer]
OnCalendar=*:0/5
# Deliberately NOT Persistent=true. Catching up a missed check would report on a
# window that has already closed, which is worse than not reporting: the answer
# wanted here is always "right now".
AccuracySec=30s

[Install]
WantedBy=timers.target
